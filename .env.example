# Copy to .env (gitignored) and change the secrets on any shared host.
# Without a .env file, compose falls back to these same dev defaults.
DB_NAME=jsoundexplorer
DB_USER=jse
DB_PASSWORD=devpw-change-me
DB_ROOT_PASSWORD=devroot-change-me

# Static-hosting mode (Pages): public HTTPS origin of the API for the build,
# and the Pages origin the API should accept. Leave both empty for compose.
# VITE_API_BASE=https://api.example.com
# CORS_ORIGIN=https://jruk8.github.io
